# .example_env — template for pipeline runs using KeccakSim_v2.
#
# Copy this file to .env (or an envs/ profile) and adjust the values.
# Run with:
#   ./pipeline_runner/run_full_pipeline.sh --env-file ./pipeline_runner/envs/<profile>.env
#
# All SHA3_* variables can also be set directly in the shell; env-file values
# override shell exports only when the pipeline script sources the file.
# To unset all SHA3_ vars in fish: set -e (set -n | string match -r '^SHA3_')


# ===========================================================================
# General
# ===========================================================================

# Number of input messages stored in one dataset folder.
SHA3_INPUTS=16

# Number of Keccak-f[1600] invocations per input message (= trace files per input).
SHA3_INVOCATIONS=10


# ===========================================================================
# 0001 — Reference
# ===========================================================================

# Number of folders used to build the reference trace.
SHA3_REFERENCE_FOLDERS=2

# Raw sample count in each reference trace file.
SHA3_REFERENCE_TRACE_LEN=13824


# ===========================================================================
# 0002 — Detection
# ===========================================================================

# Raw sample count expected in detection trace files.
SHA3_DETECTION_TRACE_LEN=13824

# Number of detection folders/sets to process.
SHA3_DETECTION_SET_COUNT=5

# How many detection sets are grouped into one part_XX.hdf5 (I/O packaging only).
SHA3_DETECTION_SETS_PER_PART=10

# Minimum Pearson correlation with the reference trace; traces below this are rejected.
SHA3_DETECTION_CORR_BOUND=0.82

# First raw sample index considered during detection preprocessing.
SHA3_DETECTION_TRACE_OFFSET=0

# Step between consecutive extracted points (larger = sparser temporal sampling).
SHA3_DETECTION_PPC=10

# Number of extracted points per processed detection trace.
SHA3_DETECTION_OUTPUT_SIZE=1382

# Number of Keccak rounds considered in detection extraction/reporting.
SHA3_DETECTION_ROUNDS=4

# Words scanned for A/B and C/D tags per round during ICS extraction.
SHA3_DETECTION_ICS_WORDS_AB=50
SHA3_DETECTION_ICS_WORDS_CD=10

# Comma-separated R² threshold list for ICS extraction; one archive per threshold.
SHA3_DETECTION_ICS_THRESHOLDS=0.09,0.08,0.07,0.06,0.05,0.04,0.03,0.02,0.01

# Additional per-point offset applied before averaging each extraction window.
SHA3_DETECTION_SAMPLE_SHIFT=0

# Number of raw samples averaged per extracted point (1 = no averaging).
SHA3_DETECTION_SAMPLE_WIDTH=1


# ===========================================================================
# 0003 — Training
# ===========================================================================

# Number of training folders (Raw_TR_xxxx) to process.
SHA3_TRAINING_SET_COUNT=10

# Raw sample count expected in each training trace file.
SHA3_TRAINING_TRACE_LEN=13824

# First raw sample index used for feature extraction.
SHA3_TRAINING_TRACE_OFFSET=0

# Raw samples aggregated into one compressed output point.
SHA3_TRAINING_PPC=1

# Compressed points kept per processed trace (window = offset + output_size * ppc).
SHA3_TRAINING_OUTPUT_SIZE=13824

# How many training folders are grouped into one part_XX.hdf5 (I/O packaging only).
SHA3_TRAINING_SETS_PER_PART=10

# Minimum Pearson correlation with the reference trace for training traces.
SHA3_TRAINING_CORR_BOUND=0.82

# Selects which ICS archive flows into training IoP extraction.
# Integer N → ics_original_0N0.zip  (e.g. 70 → ics_original_070.zip).
SHA3_TRAINING_ICS_LEVEL=70


# ===========================================================================
# 0004 — Validation
# ===========================================================================

# Number of input messages expected per validation folder.
SHA3_VALIDATION_INPUTS=10

# Number of validation folders/sets to process.
SHA3_VALIDATION_SET_COUNT=5

# First raw sample index used in validation preprocessing.
SHA3_VALIDATION_TRACE_OFFSET=0

# Raw samples aggregated per validation output point.
SHA3_VALIDATION_PPC=1

# Processed points kept per validation trace.
SHA3_VALIDATION_OUTPUT_SIZE=13824

# Minimum Pearson correlation with the reference trace for validation traces.
SHA3_VALIDATION_CORR_BOUND=0.90

# How many validation sets are grouped into one part_XX.hdf5.
SHA3_VALIDATION_SETS_PER_PART=10

# Selects the template archive used in validation (integer N → templateLDA_O0N0.zip).
SHA3_VALIDATION_TEMPLATE_TAG=10

# Selects the ICS archive used in validation (keep aligned with training ICS level).
SHA3_VALIDATION_ICS_TAG=70


# ===========================================================================
# 0005 — SASCA (belief propagation)
# ===========================================================================

# Number of validation traces processed by SASCA.
SHA3_SASCA_TRACE_COUNT=500

# Template archive used by SASCA (integer N → templateLDA_O0N0.zip).
SHA3_SASCA_TEMPLATE_TAG=10

# ICS archive used by SASCA (keep aligned with training and validation ICS level).
SHA3_SASCA_ICS_TAG=70

# Samples-per-ICS-point factor used in SASCA table generation.
SHA3_SASCA_PPC=10

# BP iterations for the iteration scan.
SHA3_SASCA_ITERATION_COUNT=40

# Maximum BP iterations per point in the rate scan.
SHA3_SASCA_RATE_BP_ITERATION_COUNT=200

# Number of points on the rate scan axis.
SHA3_SASCA_RATE_POINT_COUNT=201

# Spacing between consecutive rate scan points in unknown bits.
SHA3_SASCA_RATE_STEP_BITS=8

# Success criterion: maximum number of wrong bits still counted as a success.
SHA3_SASCA_ALLOWED_WRONG_BITS=0

# Digest length in bits used to derive known-rate bits (512 for SHA3-512).
SHA3_SASCA_OUTPUT_BITS=512


# ===========================================================================
# Simulator (KeccakSim_v2)
# ===========================================================================

# Hash algorithm to simulate.
SIM_ALGORITHM=sha3-512

# Output format for trace files written by the simulator.
SIM_TRACE_FORMAT=bin

# numpy dtype for binary trace files.
SIM_TRACE_DTYPE=float64

# Format of generated data_in / data_out index files.
SIM_BULK_DATA_FORMAT=hex

# Leakage model. Choose one:
#   hw    — Hamming weight of each word/byte (default)
#   f9    — stochastic linear model (requires SIM_F9_* settings below)
#   mixed — hw + f9 combined (requires SIM_F9_* settings)
#   id    — raw data value leaks directly (identity model)
SIM_MODE=hw

# Emission granularity:
#   byte — four 8-bit samples per leak() call (default, matches real HW behaviour)
#   word — one 32-bit sample per leak() call
SIM_GRANULARITY=byte

# Std-dev of additive Gaussian noise per sample (0.0 = noiseless).
SIM_NOISE_SIGMA=0.01

# Scale of the Hamming-distance component added on top of the primary model.
# 0.0 disables it (default). Set > 0 to model bus / register transition leakage.
SIM_HD_SCALE=0.0

# Per-component scale overrides. Leave commented to use the mode defaults:
#   hw_scale  defaults to 1.0 for hw/mixed, 0.0 for f9/id
#   f9_scale  defaults to 1.0 for f9/mixed, 0.0 for hw/id
#   id_scale  defaults to 1.0 for id,       0.0 for hw/f9/mixed
#SIM_HW_SCALE=1.0
#SIM_F9_SCALE=0.0
#SIM_ID_SCALE=0.0

# F9 table settings (only used when SIM_MODE=f9, SIM_MODE=mixed, or SIM_F9_SCALE > 0).
# The table is generated once and cached at TRACES_DIR; re-used across all groups.
SIM_F9_SEED=2839
SIM_F9_C8_RANGE=0.5
# Bit-coefficient upper bound U(0, s). Two common choices:
#   1.0    (default): E[Var_signal] = 0.667, SNR_var = 0.667/sigma^2 (crossover at sigma ≈ 0.816)
#   1.2247 (normalized, =sqrt(3/2)): E[Var_signal] = 1.0, SNR_var = 1/sigma^2 (crossover at sigma = 1.0)
#SIM_F9_BIT_COEFF_SCALE=1.0

# RNG seeds for each dataset group (change to generate different random inputs).
SIM_SEED_RE=128
SIM_SEED_DN=256
SIM_SEED_TR=512
SIM_SEED_TS=1024
