# smoke-scale env: F_9 per-leakage-point pbw (default mode), low noise.
#
# This is the F_9-faithful counterpart to .env_smoke_byte_pbw_strictICS
# (the smoke widerpbw baseline). Same numerical knobs; just relies on the
# new default simulator behaviour where each leakage point t draws its
# own (c_0..c_7, c_8) instead of reusing one shared 8-vector across all t.
#
# Compared to legacy widerpbw smoke (archive 2026-04-29_byte_pbw_widerpbw):
# this run tests the prediction that per-PoI bit-coefficient diversity
# produces more "anchor bytes" (per-byte SR ≈ 1.0) at 0004 and therefore
# better SASCA recovery at 0005. It pairs with .env_smoke_per_leakpoint_realnoise
# to also probe whether the noise-axis 0004↔0005 inversion (low-noise →
# 0004 worse, 0005 better) persists once the leakage model is corrected.
#
# Default simulator mode: SIM_PBW_SHARED is unset ⇒ F_9 per-leakage-point.
# c_8(t) baseline range: SIM_PBW_C8_RANGE=0.5 (default).

SHA3_INPUTS=16
SHA3_INVOCATIONS=10

SHA3_REFERENCE_FOLDERS=2
SHA3_REFERENCE_TRACE_LEN=55296

