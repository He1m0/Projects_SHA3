# smoke-scale env: widerpbw simulator + ICS_LEVEL=70 (untested middle-band).
#
# Purpose: ICS sweet-spot sweep. Smoke widerpbw's best result was at
# LEVEL=90 (76 / 94 / 92 SASCA at 2/3/4R). LEVEL=120 was a null result
# (≈ realnoise's). The 30 -> 90 jump was the biggest gain. The optimum
# may sit between 60 and 80 — we never tested 40, 50, 60, 70, 75, 80.
#
# This env mirrors .env_smoke_byte_pbw_widerpbw exactly except:
#   - TRAINING_ICS_LEVEL=70          (was 90)
#   - VALIDATION_TEMPLATE_TAG=70     (was 90)
#   - VALIDATION_ICS_TAG=70          (was 90)
#   - SASCA_TEMPLATE_TAG=70          (was 90)
#   - SASCA_ICS_TAG=70               (was 90)
#
# Pairs with the simulator code mod that sets pbw weights to U(0.0, 1.0)
# (the "widerpbw" patch). Use against a sandbox cloned from the existing
# smoke widerpbw sandbox so 0001 reference and 0002 ICS archives are
# already in place — rerun only 0003 + 0004 + 0005.

SHA3_INPUTS=16
SHA3_INVOCATIONS=10

SHA3_REFERENCE_FOLDERS=2
SHA3_REFERENCE_TRACE_LEN=55296

SHA3_DETECTION_TRACE_LEN=55296
SHA3_DETECTION_SET_COUNT=10
SHA3_DETECTION_SETS_PER_PART=10
SHA3_DETECTION_CORR_BOUND=0.0
SHA3_DETECTION_TRACE_OFFSET=0
SHA3_DETECTION_PPC=1
SHA3_DETECTION_OUTPUT_SIZE=55296
SHA3_DETECTION_ROUNDS=4
SHA3_DETECTION_ICS_WORDS_AB=50
SHA3_DETECTION_ICS_WORDS_CD=10
SHA3_DETECTION_ICS_THRESHOLDS=0.09,0.08,0.07,0.06,0.05,0.04,0.03,0.02,0.01
SHA3_DETECTION_SAMPLE_SHIFT=0
SHA3_DETECTION_SAMPLE_WIDTH=1

SHA3_TRAINING_SET_COUNT=50
SHA3_TRAINING_TRACE_LEN=55296
SHA3_TRAINING_TRACE_OFFSET=0
SHA3_TRAINING_PPC=1
SHA3_TRAINING_OUTPUT_SIZE=55296
SHA3_TRAINING_SETS_PER_PART=25
SHA3_TRAINING_CORR_BOUND=0.0
SHA3_TRAINING_ICS_LEVEL=70

SHA3_VALIDATION_INPUTS=10
SHA3_VALIDATION_SET_COUNT=20
SHA3_VALIDATION_TRACE_OFFSET=0
SHA3_VALIDATION_PPC=1
SHA3_VALIDATION_OUTPUT_SIZE=55296
SHA3_VALIDATION_CORR_BOUND=0.0
SHA3_VALIDATION_SETS_PER_PART=10
SHA3_VALIDATION_TEMPLATE_TAG=70
SHA3_VALIDATION_ICS_TAG=70

SHA3_SASCA_TRACE_COUNT=50
SHA3_SASCA_TEMPLATE_TAG=70
SHA3_SASCA_ICS_TAG=70
SHA3_SASCA_PPC=1
SHA3_SASCA_ITERATION_COUNT=200
SHA3_SASCA_RATE_BP_ITERATION_COUNT=200
SHA3_SASCA_RATE_POINT_COUNT=21
SHA3_SASCA_RATE_STEP_BITS=64
SHA3_SASCA_ALLOWED_WRONG_BITS=0
SHA3_SASCA_OUTPUT_BITS=512

SIM_ALGORITHM=sha3-512
SIM_TRACE_FORMAT=bin
SIM_TRACE_DTYPE=float64
SIM_BULK_DATA_FORMAT=hex
SIM_NOISE_SIGMA=0.0007
SIM_GAIN_JITTER_SIGMA=0.00007
SIM_OFFSET_JITTER_SIGMA=0.0007
SIM_SMOOTH_WINDOW=1
SIM_LEAKAGE_PROFILE=full
SIM_LEAKAGE_GRANULARITY=byte-bitweighted
SIM_SEED_PBW=2839
SIM_COMMON_WAVE_SCOPE=invocation
SIM_HW_RATIO=1.0
SIM_SEED_RE=128
SIM_SEED_DN=256
SIM_SEED_TR=512
SIM_SEED_TS=1024

# Legacy collapsed-pbw archive: pre-rework runs used a single shared
# 8-vec for all leakage points. Set SIM_PBW_SHARED=1 to reproduce that
# behaviour byte-identically against the new F_9-default simulator.
SIM_PBW_SHARED=1
